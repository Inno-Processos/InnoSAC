API_PORT=3001
# Endereço público do portal (o frontend) — vai nos botões dos e-mails e nos links dos manuais
PUBLIC_URL=https://sac.suaempresa.com.br
# Origens que podem chamar a API direto do navegador (vírgula). Vazio = só pelo frontend.
CORS_ORIGIN=
# Quem recebe a senha do admin no "instalar"
ADMIN_EMAIL=tecnico.innomaker@gmail.com
TZ=America/Sao_Paulo
# SMTP (sem SMTP_HOST os e-mails são salvos em data/emails/)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tecnico.innomaker@gmail.com
SMTP_PASS=senha-de-app-do-gmail
SMTP_FROM=tecnico.innomaker@gmail.com

# Login: "senha" (login e senha do próprio SAC) ou "authelia" (conta Innomaker + grupos do LLDAP, sem senhas no SAC)
AUTH_MODE=authelia
AUTHELIA_URL=https://auth.innomaker.com.br
# Nome do cookie de sessão do Authelia (session.cookies[].name no configuration.yml)
AUTHELIA_COOKIE=authelia_session
